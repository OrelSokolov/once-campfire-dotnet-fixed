@inherits ViewSlice<SidebarDirectPlaceholderPartial>
@{ var user = Model.User; var button = ButtonTo(ViewContext, Routes.RoomsDirectsWithUsers([user.Id]), Attributes().Class("direct borderless fill-transparent unpad")); }
@button.Open
  <span class="avatar">
    @ImageTag(ViewContext, user.AvatarPath, Attributes().AriaHidden())
  </span>

  <span class="direct__author flex align-center gap max-width min-width border-radius txt-small">
    <span class="txt-nowrap overflow-ellipsis">
      <span class="for-screen-reader">Start a ping with</span>
      @user.FirstName
    </span>
  </span>
@{ Write(button.Close); }

@inherits ViewSlice<BotFormPartial>
@{ var form = Model.Form; var bot = Model.Bot; }
<h1 class="for-screen-reader">Chat Bot Setup</h1>
<label class="align-center center avatar__form gap" data-controller="upload-preview">
  <div class="btn input--file">
    @ImageTag(ViewContext, "camera.svg", Attributes().AriaHidden().Size(20))
    @form.FileField(ParamNames.Users.Avatar, Attributes().Class("input").Accept("image/*").Data("upload_preview_target", "input").Data("action", "upload-preview#previewImage"))
    <span class="for-screen-reader">Upload bot avatar</span>
  </div>

  <div class="avatar input--file txt-xx-large" style="--avatar-size: var(--btn-size);">
    @ImageTag(ViewContext, bot.AvatarUrl ?? "default-bot-avatar.svg", Attributes().Alt("Bot avatar").Size(48).Data("upload_preview_target", "image"))
  </div>
</label>

<div class="flex align-center gap">
  @TranslationButton(ViewContext, "bot_name")
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    @form.TextField(ParamNames.Users.Name, bot.Name, Attributes().Class("input").Autocomplete("name").Placeholder("Name the bot").Autofocus().Required().Data("1p-ignore", true))
    @ImageTag(ViewContext, "bot.svg", Attributes().AriaHidden().Size(24).Class("colorize--black"))
  </label>
</div>

<div class="flex align-center gap">
  @TranslationButton(ViewContext, "webhook_url")
  <label class="flex align-center gap flex-item-grow txt-large input input--actor">
    @form.UrlField(ParamNames.Users.WebhookUrl, bot.WebhookUrl, Attributes().Class("input").Placeholder("Webhook URL"))
    @ImageTag(ViewContext, "web.svg", Attributes().AriaHidden().Size(24).Class("colorize--black"))
  </label>
</div>

@ProfileFormSubmitButton(ViewContext)

@inherits PageSlice<WelcomePage>


<div id="message-area" class="message-area">
  <div class="message-area--empty min-width center">
    <figure class="center pad">
      @ImageTag(ViewContext, "messages-empty.svg", Attributes().AriaHidden().Class("colorize--black translucent"))
      <span class="for-screen-reader">@ViewContext.CurrentUser?.Name</span>
    </figure>
  </div>
</div>
@functions {
    protected override string? PageTitle => "No rooms yet";

    protected override string? BodyClass => "sidebar";

    protected override Task ExecuteSectionAsync( string sectionName )
    {
        if ( sectionName == ContentFor.Sidebar )
        {
            WriteHtml( UsersHelper.SidebarTurboFrameTag( Routes.UserSidebar, SafeHtml.Empty ) );
        }

        return Task.CompletedTask;
    }
}

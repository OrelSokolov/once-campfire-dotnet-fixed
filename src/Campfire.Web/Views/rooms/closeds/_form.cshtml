@inherits ViewSlice<ClosedRoomFormPartial>
@{ /* `<% end %>` ends the line: no newline after the layout. */ Write(await Partial(Views.rooms.layouts._form.Create(new RoomFormLayout(ViewContext, Model.Form.Room, Model.Form.CanAdminister, RoomKind.Closed, Body)))); }
@functions {
    /// <summary>The block rooms/layouts/_form yields.</summary>
    private async ValueTask Body( )
    {
        var form = Model.Form;
@:
@:  @UserFilterMenuTagOpen()
        if ( form.CanAdminister )
        {
      <li class="flex align-center gap margin-none">
        <figure class="avatar flex-item-no-shrink" style="--avatar-border-radius: 0; --avatar-size: 4ch;">
          @ImageTag(ViewContext, "everyone.svg", Attributes().AriaHidden().Class("colorize--black").Style("background-color: transparent"))
          <span class="for-screen-reader">Everyone</span>
        </figure>

        <div class="min-width">
          <div class="overflow-ellipsis fill-shade"><strong>Everyone</strong></div>
        </div>

        <hr class="separator" aria-hidden="true">

        @LinkToOpen(Model.TypeChangePath, Attributes().Class("btn--faux flex-inline").Tabindex("-1").Data("turbo_action", "replace"))
          <label for="room_type" class="switch">
            <input type="checkbox" id="room_type" class="switch__input">
            <span class="switch__btn round"></span>
            <span class="for-screen-reader">Give everyone access to this room</span>
          </label>
@Raw("</a>")      </li>
@:
      <hr class="separator full-width" style="--border-style: solid">
        }
@:
@:    @(form.SelectedUsers.Count + form.UnselectedUsers.Count > 20 ? UserFilterSearchTag() : SafeHtml.Empty)
@:
    <div data-filter-target="list" contents>
      @await Each(form.SelectedUsers, user => Partial(Views.rooms.closeds._user.Create(new ClosedRoomUserPartial(ViewContext, form, user, true))))

      @if (form.SelectedUsers.Count > 0 && form.UnselectedUsers.Count > 0)
      {
        <hr class="separator full-width" style="--border-style: solid">
      }

      @await Each(form.UnselectedUsers, user => Partial(Views.rooms.closeds._user.Create(new ClosedRoomUserPartial(ViewContext, form, user, false))))
    </div>
        WriteLiteral( "</menu>" );
        await Task.CompletedTask;
    }
}

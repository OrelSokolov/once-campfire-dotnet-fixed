@inherits ViewSlice<ContextPartial>
@{ var platform = ViewContext.Platform; var browser = RubyText.Capitalize(platform.Browser); }
@if (!((platform.Safari || platform.Chrome) && platform.Ios))
{
  <details class="notifications-help" data-notifications-target="details">
    <summary class="btn">
      @ImageTag(ViewContext, "external/web.svg", Attributes().AriaHidden().Size(20))
      <strong>Check your @browser settings</strong>
      @ImageTag(ViewContext, "disclosure.svg", Attributes().AriaHidden().Size(10).Class("disclosure"))
    </summary>

    @if (platform is { Firefox: true, Android: true })
    {
        <ol>
          <li>Tap <em>@ImageTag(ViewContext, "lock.svg", Attributes().Alt("the View site information button").Size(20))</em> in the address bar.</li>
          <li>Tap <em>Notification</em> to change to <em>Allowed</em>.</li>
        </ol>
    }
    else if (platform is { Edge: true, Desktop: true })
    {
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em>@ImageTag(ViewContext, "lock.svg", Attributes().Alt("the View site information button").Size(20))</em> left of the address bar.</li>
          <li>Under <em>Permissions for this site &gt; Notifications</em>, choose <em>Allow</em>.</li>
        </ol>
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for @browser.</h2>
        <ol>
          @if (platform.Windows)
          {
            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>@ImageTag(ViewContext, "external/switch.svg", Attributes().Alt("the switch").Size(22))</em> <em>ON</em> for @browser.</li>
          }
          else
          {
            <li>Click <em aria-label="the Apple menu">@AppleLogo</em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>@browser</em>.</li>
            <li>Click <em>@ImageTag(ViewContext, "external/switch.svg", Attributes().Alt("the switch").Size(22))</em> to <em>Allow notifications</em>.</li>
          }
        </ol>
    }
    else if (platform is { Firefox: true, Desktop: true })
    {
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click <em>@browser</em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click <em>Privacy & Security</em> in the sidebar.</li>
          <li>Scroll down to <em>Permissions</em>.</li>
          <li>Click <em>Settings</em> next to <em>Notifications</em>.</li>
          <li>Select <em>Allow</em> next to <em>@ViewContext.Url(Routes.Root)</em>.</li>
        </ol>
@:
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for @browser.</h2>
        <ol>
          @if (platform.Windows)
          {
            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>@ImageTag(ViewContext, "external/switch.svg", Attributes().Alt("the toggle button").Size(22))</em> <em>ON</em> for @browser.</li>
          }
          else
          {
            <li>Click <em aria-label="the Apple menu">@AppleLogo</em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>@browser</em>.</li>
            <li>Click <em>@ImageTag(ViewContext, "external/switch.svg", Attributes().Alt("the switch").Size(22))</em> to <em>Allow notifications</em>.</li>
          }
        </ol>
    }
    else if (platform is { Chrome: true, Desktop: true })
    {
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for this website.</h2>
        <ol>
          <li>Click the <em>@ImageTag(ViewContext, "external/sliders.svg", Attributes().Alt("View site information").Size(20))</em> icon in the address bar.</li>
          <li>Click <em>Site Settings</em>.</li>
          <li>Ensure notifications are <em>Allowed</em>.</li>
        </ol>
@:
        <h2 class="txt-normal txt-medium margin-block-start">Turn on notifications for @browser.</h2>
        <ol>
          @if (platform.Windows)
          {
            <li>Click <em>Start</em>, then <em>Settings</em>.</li>
            <li>Go to <em>System &gt; Notification</em>.</li>
            <li>Click <em>@ImageTag(ViewContext, "external/switch.svg", Attributes().Alt("the switch").Size(22))</em> <em>ON</em> for @browser.</li>
          }
          else
          {
            <li>Click <em aria-label="the Apple menu">@AppleLogo</em> in the top left.</li>
            <li>Click <em>System Settings…</em>.</li>
            <li>Click <em>Notifications</em>.</li>
            <li>Click <em>@browser</em>.</li>
            <li>Click <em>@ImageTag(ViewContext, "external/switch.svg", Attributes().Alt("the switch").Size(22))</em> to <em>Allow notifications</em>.</li>
          }
        </ol>
    }
    else if (platform is { Chrome: true, Android: true })
    {
        <ol>
          <li>Tap the <em>@ImageTag(ViewContext, "menu-dots-vertical.svg", Attributes().Alt("More options").Size(16))</em> menu button.</li>
          <li>Tap <em>Settings</em>.</li>
          <li>Tap <em>Notifications</em>.</li>
          <li>Tap <em>@ImageTag(ViewContext, "external/switch.svg", Attributes().Alt("the switch").Size(22))</em> to <em>Allow @browser notifications</em>.</li>
          <li>Tap <em>@ImageTag(ViewContext, "external/switch.svg", Attributes().Alt("the switch").Size(22))</em> next to <em>Web apps</em>.</li>
          <li>Tap <em>@ImageTag(ViewContext, "notification-bell-alert.svg", Attributes().Alt("the notification bell").Size(16))</em> and select <em>Allow</em>.</li>
        </ol>
    }
    else if (platform is { Safari: true, Desktop: true })
    {
        <ol>
          <li>Click <em>@browser</em> in the top left.</li>
          <li>Click <em>Settings…</em>.</li>
          <li>Click the <em>Websites</em> tab.</li>
          <li>Click <em>Notifications</em> in the sidebar.</li>
          <li>Click <em>@ViewContext.Url(Routes.Root)</em> in the list.</li>
          <li>Select <em>Allow</em>.</li>
        </ol>
    }
    else
    {
        <p>Ensure notifications are enabled for <em>@ViewContext.Url(Routes.Root)</em> in your web browser settings.</p>
    }
  </details>
}
